# Public site URL (canonical production domain)
VITE_SITE_URL=https://clearflowpm.com

# Sentry client DSN (optional locally; set in Vercel for preview/production)
# VITE_SENTRY_DSN=

# Server-only — set in Vercel project settings (never prefix with VITE_)
# N8N_WEBHOOK_URL=
# N8N_WEBHOOK_SECRET=

# Scripts only — store real values in .env.local (gitignored)
# LINEAR_API_KEY=
# LINEAR_TEAM_ID=
# LINEAR_PROJECT_NAME=ClearFlow Plumbing Website

# Optional override for label sync
# GITHUB_REPO=T-bizgrow-solutions/clearflow-plumbing-website
